{
  "datasets": [
    {
      "name": "3c5e1c5b",
      "displayName": "video_performance",
      "config": {
        "version": "1.1",
        "source": "youtube_coffee_creators.gold.video_performance",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "band_label",
            "expr": "case length_band\r\n  when '0-3 min'   then '00–03 min'\r\n  when '3-10 min'  then '03–10 min'\r\n  when '10-20 min' then '10–20 min'\r\n  when '20-40 min' then '20–40 min'\r\n  else '40+ min'\r\nend",
            "displayName": "Band Label"
          },
          {
            "name": "day_label",
            "expr": "left(publish_day_utc, 3)",
            "displayName": "Day Label"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "median_engagement",
            "expr": "MEDIAN(engagement_rate)",
            "displayName": "Median Engagement",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "max",
                "places": 2.0
              },
              "hideGroupSeparator": false
            }
          },
          {
            "name": "shorts_upload_share",
            "expr": "SUM(CASE WHEN format = 'Short (est.)' THEN 1 ELSE 0 END) / COUNT(video_id)",
            "displayName": "Shorts Upload Share"
          },
          {
            "name": "shorts_view_share",
            "expr": "SUM(CASE WHEN format = 'Short (est.)' THEN view_count ELSE 0 END) / SUM(view_count)",
            "displayName": "Shorts View Share"
          }
        ]
      }
    },
    {
